eld_image\",\r\n        \"src\": \"data:image/png;base64,\",\r\n        \"width\": 20,\r\n        \"height\": 20\r\n      },\r\n      {\r\n        \"type\": \"input_dummy\"\r\n      },\r\n      {\r\n        \"type\": \"field_dropdown\",\r\n        \"name\": \"line\",\r\n        \"options\": [\r\n          [\r\n            {\r\n              \"src\": \"data:image/png;base64,\",\r\n              \"width\": 150,\r\n              \"height\": 150\r\n            }, \"zigzag_to_curve\"\r\n          ],\r\n          [\r\n            {\r\n              \"src\": \"data:image/png;base64,\",\r\n              \"width\": 150,\r\n              \"height\": 150\r\n            }, \"curve_to_zigzag\"\r\n          ],\r\n        ]\r\n      }\r\n    ],\r\n    \"inputsInline\": false,\r\n    \"previousStatement\": null,\r\n    \"nextStatement\": null,\r\n    \"colour\": \"#28D1E0\",\r\n    \"tooltip\": \"\",\r\n    \"helpUrl\": \"\"\r\n  },\r\n  {\r\n    \"type\": \"custom_line_zigzag_curve_pick\",\r\n    \"message0\": \"%1 zigzag curve and pick %2 %3\",\r\n    \"args0\": [\r\n      {\r\n        \"type\": \"field_image\",\r\n        \"src\": \"data:image/png;base64,\",\r\n        \"width\": 20,\r\n        \"height\": 20\r\n      },\r\n      {\r\n        \"type\": \"input_dummy\"\r\n      },\r\n      {\r\n        \"type\": \"field_dropdown\",\r\n        \"name\": \"line\",\r\n        \"options\": [\r\n          [\r\n            {\r\n              \"src\": \"data:image/png;base64,\",\r\n              \"width\": 150,\r\n              \"height\": 150\r\n            }, \"zigzag_to_curve\"\r\n          ],\r\n          [\r\n            {\r\n              \"src\": \"data:image/png;base64,\",\r\n              \"width\": 150,\r\n              \"height\": 150\r\n            }, \"curve_to_zigzag\"\r\n          ],\r\n        ]\r\n      }\r\n    ],\r\n    \"inputsInline\": false,\r\n    \"previousStatement\": null,\r\n    \"nextStatement\": null,\r\n    \"colour\": \"#28D1E0\",\r\n    \"tooltip\": \"\",\r\n    \"helpUrl\": \"\"\r\n  },\r\n  {\r\n    \"type\": \"custom_line_obstacle\",\r\n    \"message0\": \"%1 obstacle %2 เวลาที่ใช้ข้ามสิ่งกีดขวาง %3 %4\",\r\n    \"args0\": [\r\n      {\r\n        \"type\": \"field_image\",\r\n        \"src\": \"data:image/png;base64,\",\r\n        \"width\": 20,\r\n        \"height\": 20\r\n      },\r\n      {\r\n        \"type\": \"input_dummy\"\r\n      },\r\n      {\r\n        \"type\": \"input_value\",\r\n        \"name\": \"time\",\r\n        \"check\": \"Number\",\r\n        \"align\": \"RIGHT\"\r\n      },\r\n      {\r\n        \"type\": \"field_dropdown\",\r\n        \"name\": \"line\",\r\n        \"options\": [\r\n          [\r\n            {\r\n              \"src\": \"data:image/png;base64,\",\r\n              \"width\": 150,\r\n              \"height\": 150\r\n            }, \"obstacle\"\r\n          ]\r\n        ]\r\n      }\r\n    ],\r\n    \"inputsInline\": false,\r\n    \"previousStatement\": null,\r\n    \"nextStatement\": null,\r\n    \"colour\": \"#28D1E0\",\r\n    \"tooltip\": \"\",\r\n    \"helpUrl\": \"\"\r\n  }\r\n]);\r\n\r\nBlockly.Blocks['custom_line_junction'] = {\r\n  init: function () {\r\n    this.appendDummyInput()\r\n      .appendField(new Blockly.FieldDropdown([\r\n        [{\r\n          \"src\": \"boards/atom-vx/images/line_left.png\",\r\n          \"width\": 40,\r\n          \"height\": 40\r\n        }, \"line_left\"],\r\n        [{\r\n          \"src\": \"boards/atom-vx/images/line_center.png\",\r\n          \"width\": 40,\r\n          \"height\": 40\r\n        }, \"line_center\"],\r\n        [{\r\n          \"src\": \"boards/atom-vx/images/line_right.png\",\r\n          \"width\": 40,\r\n          \"height\": 40\r\n        }, \"line_right\"]\r\n      ]), \"junction_type\");\r\n    this.setOutput(true, \"junction_type\");\r\n    this.setColour(\"#28D1E0\");\r\n    this.setTooltip(\"\");\r\n    this.setHelpUrl(\"\");\r\n  }\r\n};\r\n\r\nBlockly.Blocks['custom_line_turn_direction'] = {\r\n  init: function () {\r\n    this.appendDummyInput()\r\n      .appendField(new Blockly.FieldDropdown([\r\n        [\"turn left\", \"turn_left\"],\r\n        [\"turn right\", \"turn_right\"],\r\n        [\"spin left\", \"spin_left\"],\r\n        [\"spin right\", \"spin_right\"],\r\n        [\"no turn\", \"no_turn\"]\r\n      ]), \"direction\");\r\n    this.setOutput(true, \"turn_direction_type\");\r\n    this.setInputsInline(true);\r\n    this.setColour(\"#28D1E0\");\r\n    this.setTooltip(\"\");\r\n    this.setHelpUrl(\"\");\r\n  }\r\n};\r\n\r\nBlockly.Blocks['custom_line_init_servo'] = {\r\n  init: function () {\r\n    this.appendDummyInput()\r\n      .appendField(new Blockly.FieldImage(\"data:image/png;base64,\", 20, 20))\r\n      .appendField(\"init servo\");\r\n    this.appendValueInput(\"servo_up\")\r\n      .setCheck(\"Number\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"servo up\");\r\n    this.appendValueInput(\"servo_down\")\r\n      .setCheck(\"Number\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"servo down\");\r\n    this.appendValueInput(\"servo_open\")\r\n      .setCheck(\"Number\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"servo open\");\r\n    this.appendValueInput(\"servo_close\")\r\n      .setCheck(\"Number\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"servo close\");\r\n    this.setInputsInline(false);\r\n    this.setPreviousStatement(true, null);\r\n    this.setNextStatement(true, null);\r\n    this.setColour(\"#28D1E0\");\r\n    this.setTooltip(\"\");\r\n    this.setHelpUrl(\"\");\r\n  }\r\n};\r\n\r\nBlockly.Blocks['custom_calibrate_turn'] = {\r\n  init: function () {\r\n    this.appendDummyInput()\r\n      .appendField(new Blockly.FieldImage(\"data:image/png;base64,\", 20, 20))\r\n      .appendField(\"calibrate turn\");\r\n    this.setOutput(true, \"turn_direction_type\");\r\n    this.setInputsInline(true);\r\n    this.setColour(\"#28D1E0\");\r\n    this.setTooltip(\"\");\r\n    this.setHelpUrl(\"\");\r\n  }\r\n};\r\n\r\nBlockly.Blocks['custom_set_turn'] = {\r\n  init: function () {\r\n    this.appendDummyInput()\r\n      .appendField(new Blockly.FieldImage(\"data:image/png;base64,\", 20, 20))\r\n      .appendField(\"set turn\");\r\n    this.appendValueInput(\"turn_left\")\r\n      .setCheck(\"Number\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"turn left\");\r\n    this.appendValueInput(\"turn_right\")\r\n      .setCheck(\"Number\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"turn right\");\r\n    this.setInputsInline(false);\r\n    this.setPreviousStatement(true, null);\r\n    this.setNextStatement(true, null);\r\n    this.setColour(\"#28D1E0\");\r\n    this.setTooltip(\"\");\r\n    this.setHelpUrl(\"\");\r\n  }\r\n};\r\n\r\nBlockly.Blocks['custom_line_follow_line_time'] = {\r\n  init: function () {\r\n    this.appendDummyInput()\r\n      .appendField(new Blockly.FieldImage(\"data:image/png;base64,\", 20, 20))\r\n      .appendField(\"วิ่งตามเส้นตามเวลาที่กำหนด\");\r\n    this.appendValueInput(\"speed\")\r\n      .setCheck(\"Number\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"ความเร็ว (%)\");\r\n    this.appendValueInput(\"time\")\r\n      .setCheck(\"Number\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"เวลา (วินาที)\");\r\n    this.appendValueInput(\"stop\")\r\n      .setCheck(\"Boolean\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"หยุดการเคลื่อนที่เมื่อครบเวลา\");\r\n    this.setInputsInline(false);\r\n    this.setPreviousStatement(true, null);\r\n    this.setNextStatement(true, null);\r\n    this.setColour(\"#28D1E0\");\r\n    this.setTooltip(\"\");\r\n    this.setHelpUrl(\"\");\r\n  }\r\n};\r\n\r\nBlockly.Blocks['custom_line_follow_line_turn'] = {\r\n  init: function () {\r\n    this.appendDummyInput()\r\n      .appendField(new Blockly.FieldImage(\"data:image/png;base64,\", 20, 20))\r\n      .appendField(\"วิ่งตามเส้นพร้อมเลี้ยว\");\r\n    this.appendValueInput(\"fast_speed_time\")\r\n      .setCheck(\"Number\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"เวลาที่ใช้ความเร็วสูงสุด (วินาที)\");\r\n    this.appendValueInput(\"junction\")\r\n      .setCheck(\"junction_type\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"แยกที่ต้องการเช็ค\");\r\n    this.appendValueInput(\"turn\")\r\n      .setCheck(\"turn_direction_type\")\r\n      .setAlign(Blockly.ALIGN_RIGHT)\r\n      .appendField(\"เลี้ยวหรือหมุนตัว\");\r\n    this.setInputsInline(false);\r\n    this.setPreviousStatement(true, null);\r\n    this.setNextStatement(true, null);\r\n    this.setColour(\"#28D1E0\");\r\n    this.setTooltip(\"\");\r\n    this.setHelpUrl(\"\");\r\n  }\r\n};",
          "generators.js": "Blockly.Python['custom_line_init_servo'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var servo_up = Blockly.Python.valueToCode(block, 'servo_up', Blockly.Python.ORDER_ATOMIC);\r\n    var servo_down = Blockly.Python.valueToCode(block, 'servo_down', Blockly.Python.ORDER_ATOMIC);\r\n    var servo_open = Blockly.Python.valueToCode(block, 'servo_open', Blockly.Python.ORDER_ATOMIC);\r\n    var servo_close = Blockly.Python.valueToCode(block, 'servo_close', Blockly.Python.ORDER_ATOMIC);\r\n\r\n    var code = `custom.init_servo(${servo_up}, ${servo_down}, ${servo_open}, ${servo_close})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_calibrate_turn'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var code = `custom.calibrate_turn()`;\r\n    return [code, Blockly.Python.ORDER_NONE];\r\n};\r\n\r\nBlockly.Python['custom_set_turn'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var turn_left = Blockly.Python.valueToCode(block, 'turn_left', Blockly.Python.ORDER_ATOMIC);\r\n    var turn_right = Blockly.Python.valueToCode(block, 'turn_right', Blockly.Python.ORDER_ATOMIC);\r\n\r\n    var code = `custom.set_turn(${turn_left}, ${turn_right})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_follow_line_time'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var speed = Blockly.Python.valueToCode(block, 'speed', Blockly.Python.ORDER_ATOMIC);\r\n    var time = Blockly.Python.valueToCode(block, 'time', Blockly.Python.ORDER_ATOMIC);\r\n    var stop = Blockly.Python.valueToCode(block, 'stop', Blockly.Python.ORDER_ATOMIC);\r\n\r\n    var code = `custom.follow_line_time(${speed}, ${time}, ${stop})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_follow_line_turn'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var fast_speed_time = Blockly.Python.valueToCode(block, 'fast_speed_time', Blockly.Python.ORDER_ATOMIC);\r\n    var junction = Blockly.Python.valueToCode(block, 'junction', Blockly.Python.ORDER_ATOMIC);\r\n    var turn = Blockly.Python.valueToCode(block, 'turn', Blockly.Python.ORDER_ATOMIC);\r\n\r\n    var code = `custom.follow_line_turn(${fast_speed_time}, ${junction}, ${turn})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_junction'] = function (block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_line_follower'] = 'import line_follower';\r\n\r\n    var junction_type = block.getFieldValue('junction_type');\r\n\r\n    var code = `line_follower.${junction_type}`;\r\n    return [code, Blockly.Python.ORDER_ATOMIC];\r\n};\r\n\r\nBlockly.Python['custom_line_turn_direction'] = function (block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_line_follower'] = 'import line_follower';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var direction = block.getFieldValue('direction');\r\n\r\n    var code = `custom.${direction}`;\r\n    return [code, Blockly.Python.ORDER_ATOMIC];\r\n};\r\n\r\nBlockly.Python['custom_line_square_2_junction'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var line = block.getFieldValue('line');\r\n\r\n    var code = `custom.square_2_junction(custom.${line})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_square_4_junction'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var line = block.getFieldValue('line');\r\n\r\n    var code = `custom.square_4_junction(custom.${line})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_square_2_junction_pick'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var line = block.getFieldValue('line');\r\n\r\n    var code = `custom.square_2_junction_pick(custom.${line})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_square_4_junction_pick'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var line = block.getFieldValue('line');\r\n\r\n    var code = `custom.square_4_junction_pick(custom.${line})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_diamond_4_junction'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var line = block.getFieldValue('line');\r\n\r\n    var code = `custom.diamond_4_junction(custom.${line})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_diamond_4_junction_pick'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var line = block.getFieldValue('line');\r\n\r\n    var code = `custom.diamond_4_junction_pick(custom.${line})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_zigzag'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var code = `custom.zigzag()\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_zigzag_pick'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var code = `custom.zigzag_pick()\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_curve'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var code = `custom.curve()\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_curve_pick'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var code = `custom.curve_pick()\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_zigzag_curve'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var line = block.getFieldValue('line');\r\n\r\n    var code = `custom.zigzag_curve(custom.${line})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_zigzag_curve_pick'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var line = block.getFieldValue('line');\r\n\r\n    var code = `custom.zigzag_curve_pick(custom.${line})\\n`;\r\n    return code;\r\n};\r\n\r\nBlockly.Python['custom_line_obstacle'] = function(block) {\r\n    Blockly.Python.definitions_['import_board'] = 'import board';\r\n    Blockly.Python.definitions_['import_custom'] = 'import custom';\r\n\r\n    var time = Blockly.Python.valueToCode(block, 'time', Blockly.Python.ORDER_ATOMIC);\r\n\r\n    var code = `custom.obstacle(${time})\\n`;\r\n    return code;\r\n};"
        },
        "extension.js": "({\n    name: \"Custom\", // Category Name\n    description: \"Custom Block for PT Atom VX\",\n    author: \"PT Robotics\",\n    category: \"Robot\",\n    version: \"1.0.0\",\n    icon: \"/static/icon.png\", // Category icon\n    color: \"#28B463\", // Category color (recommend some blocks color)\n    blocks: [ // Blocks in Category\n        {\n            xml: `\n                <block type=\"custom_line_init_servo\">\n                    <value name=\"servo_up\">\n                        <shadow type=\"math_number\">\n                            <field name=\"NUM\">180</field>\n                        </shadow>\n                    </value>\n                    <value name=\"servo_down\">\n                        <shadow type=\"math_number\">\n                            <field name=\"NUM\">180</field>\n                        </shadow>\n                    </value>\n                    <value name=\"servo_open\">\n                        <shadow type=\"math_number\">\n                            <field name=\"NUM\">180</field>\n                        </shadow>\n                    </value>\n                    <value name=\"servo_close\">\n                        <shadow type=\"math_number\">\n                            <field name=\"NUM\">180</field>\n                        </shadow>\n                    </value>\n                </block>\n            `\n        },\n        // \"custom_calibrate_turn\",\n        // {\n        //     xml: `\n        //         <block type=\"custom_set_turn\">\n        //             <value name=\"turn_left\">\n        //                 <shadow type=\"math_number\">\n        //                     <field name=\"NUM\">0.05</field>\n        //                 </shadow>\n        //             </value>\n        //             <value name=\"turn_right\">\n        //                 <shadow type=\"math_number\">\n        //                     <field name=\"NUM\">0.05</field>\n        //                 </shadow>\n        //             </value>\n        //         </block>\n        //     `\n        // },\n        {\n            xml: `\n                <block type=\"custom_line_follow_line_time\">\n                    <value name=\"speed\">\n                        <shadow type=\"math_number\">\n                            <field name=\"NUM\">70</field>\n                        </shadow>\n                    </value>\n                    <value name=\"time\">\n                        <shadow type=\"math_number\">\n                            <field name=\"NUM\">0.5</field>\n                        </shadow>\n                    </value>\n                    <value name=\"stop\">\n                        <shadow type=\"logic_boolean\">\n                            <field name=\"BOOL\">TRUE</field>\n                        </shadow>\n                    </value>\n                </block>\n            `\n        },\n        {\n            xml: `\n                <block type=\"custom_line_follow_line_turn\">\n                    <value name=\"fast_speed_time\">\n                        <shadow type=\"math_number\">\n                            <field name=\"NUM\">0.0</field>\n                        </shadow>\n                    </value>\n                    <value name=\"junction\">\n                        <shadow type=\"custom_line_junction\">\n                            <field name=\"junction_type\">line_right</field>\n                        </shadow>\n                    </value>\n                    <value name=\"turn\">\n                        <shadow type=\"custom_line_turn_direction\">\n                            <field name=\"direction\">turn_right</field>\n                        </shadow>\n                    </value>\n                </block>\n            `\n        },\n        \"custom_line_square_2_junction\",\n        \"custom_line_square_4_junction\",\n        \"custom_line_square_2_junction_pick\",\n        \"custom_line_square_4_junction_pick\",\n        \"custom_line_diamond_4_junction\",\n        \"custom_line_diamond_4_junction_pick\",\n        \"custom_line_zigzag\",\n        \"custom_line_zigzag_pick\",\n        \"custom_line_curve\",\n        \"custom_line_curve_pick\",\n        \"custom_line_zigzag_curve\",\n        \"custom_line_zigzag_curve_pick\",\n        {\n            xml: `\n                <block type=\"custom_line_obstacle\">\n                    <value name=\"time\">\n                        <shadow type=\"math_number\">\n                            <field name=\"NUM\">1.3</field>\n                        </shadow>\n                    </value>\n                </block>\n            `\n        },\n    ],\n    chip: [ // Chip support\n        \"ESP32\"\n    ],\n    supportArduinoPlatform: true,\n    depends: []\n});\n",
        "modules": {
          "custom.py": "import robot\nimport line_follower\nimport board\nfrom time import sleep\n\nSTART_SPEED = 20\nSLOW_SPEED = 25\nFAST_SPEED = 60\nTURN_SLOW_SPEED = 30\nTURN_FAST_SPEED = 50\nFAST_TIME_TURN_90 = 0.1\nSPIN_SLOW_SPEED = 20\nSPIN_FAST_SPEED = 60\nFAST_TIME_SPIN_90 = 0.07\nKP_SLOW = 0.05\nKD_SLOW = 0.08\nKP_FAST = 0.2\nKD_FAST = 2.0\nSERVO_UP = 0\nSERVO_DOWN = 0\nSERVO_OPEN = 0\nSERVO_CLOSE = 0\nturn_left = 0\nturn_right = 1\nspin_left = 2\nspin_right = 3\nno_turn = 4\nsquare_2_junction_l = 0\nsquare_2_junction_r = 1\nsquare_4_junction_l = 0\nsquare_4_junction_r = 1\nsquare_4_junction_lf = 2\nsquare_4_junction_rf = 3\ndiamond_4_junction_l = 0\ndiamond_4_junction_r = 1\ndiamond_4_junction_lf = 2\ndiamond_4_junction_rf = 3\nzigzag_to_curve = 0\ncurve_to_zigzag = 1\ncenter_left = 0\ncenter_right = 1\ncenter_cross = 2\n\ntime_to_center_left = 0.02\ntime_to_center_right = 0.02\n\nrobot.set_ramp(0.4, 0.2)\n\n# Physical startup yaw, independent of later per-block offset resets.\n_OBSTACLE_START_YAW = (robot.read_angle(robot.yaw) + robot.angles_offset[2]) % 360\n\ndef normalize_angle(angle):\n    return angle - 360 if angle > 180 else angle\n\ndef init_servo(servo_up, servo_down, servo_open, servo_close):\n    global SERVO_UP, SERVO_DOWN, SERVO_OPEN, SERVO_CLOSE\n    SERVO_UP = servo_up\n    SERVO_DOWN = servo_down\n    SERVO_OPEN = servo_open\n    SERVO_CLOSE = servo_close\n\ndef pick_can_slow():\n    for i in range(SERVO_OPEN, SERVO_CLOSE, 4):\n        robot.servo_set_degree(1, i)\n        sleep(0.002)\n\ndef check_on_line():\n    sensor_0_value = line_follower.read_calibrated_sensor(0)\n    sensor_7_value = line_follower.read_calibrated_sensor(7)\n    if sensor_0_value < 50 or sensor_7_value < 50:\n        robot.move(robot.forward, START_SPEED)\n        sleep(0.1)\n        robot.motor_stop_all()\n\ndef align_robot():\n    while True:\n        if (abs(line_follower.read_position()) > 10):\n            line_follower.follow_line(5, START_SPEED, 0.2, 0.3)\n        else:\n            robot.motor_stop_all()\n            break\n\ndef check_center():\n    sensor_0_value = line_follower.read_calibrated_sensor(0)\n    sensor_7_value = line_follower.read_calibrated_sensor(7)\n    if sensor_0_value < 50 or sensor_7_value < 50:\n        robot.move(robot.forward, START_SPEED)\n        sleep(0.1)\n\n    sensor_0_found = False\n    sensor_7_found = False\n    while True:\n        if line_follower.read_calibrated_sensor(0) < 50:\n            sensor_0_found = True\n        if line_follower.read_calibrated_sensor(7) < 50:\n            sensor_7_found = True\n        if sensor_0_found == True and sensor_7_found == True:\n            robot.motor_stop_all()\n            break\n        line_follower.follow_line(START_SPEED, FAST_SPEED, KP_SLOW, KD_SLOW)\n\ndef check_center_diamond():\n    sensor_0_value = line_follower.read_calibrated_sensor(0)\n    sensor_7_value = line_follower.read_calibrated_sensor(7)\n    if sensor_0_value < 50 or sensor_7_value < 50:\n        robot.move(robot.forward, SLOW_SPEED)\n        sleep(0.1)\n\n    sensor_0_found = False\n    sensor_7_found = False\n    while True:\n        if line_follower.read_calibrated_sensor(1) < 50:\n            sensor_0_found = True\n        if line_follower.read_calibrated_sensor(6) < 50:\n            sensor_7_found = True\n        if sensor_0_found == True and sensor_7_found == True:\n            robot.motor_stop_all()\n            break\n        line_follower.follow_line(START_SPEED, FAST_SPEED, KP_SLOW, KD_SLOW)\n\ndef go_to_center(direction):\n    slow_speed = 20\n    if direction == center_left:\n        while line_follower.read_calibrated_sensor(8) > 50:\n            robot.move(robot.forward, START_SPEED)\n        robot.move(robot.forward, START_SPEED)\n        sleep(time_to_center_left)\n    elif direction == center_right:\n        while line_follower.read_calibrated_sensor(9) > 50:\n            robot.move(robot.forward, START_SPEED)\n        robot.move(robot.forward, START_SPEED)\n        sleep(time_to_center_right)\n    elif direction == center_cross:\n        while True:\n            sensor_left_value = line_follower.read_calibrated_sensor(8)\n            sensor_right_value = line_follower.read_calibrated_sensor(9)\n            if sensor_left_value > 50:\n                robot.motor_drive(1, slow_speed)\n            else:\n                robot.motor_drive(1, 0)\n            if sensor_right_value > 50:\n                robot.motor_drive(2, slow_speed)\n            else:\n                robot.motor_drive(2, 0)\n            if sensor_left_value < 50 and sensor_right_value < 50:\n                break\n        robot.move(robot.forward, slow_speed)\n        sleep(time_to_center_left)\n        robot.motor_stop_all()\n\n_square_exit_ready = False\n\ndef follow_line_time(speed, duration, stop):\n    global _square_exit_ready\n    _square_exit_ready = False\n    kp_slow = 0.12\n    kd_slow = 0.12\n    if speed <= 30:\n        line_follower.follow_line_time(START_SPEED, speed, kp_slow, kd_slow, duration / 2, False)\n        line_follower.follow_line_time(speed, START_SPEED, kp_slow, kd_slow, duration / 2, stop)\n    else:\n        line_follower.follow_line_time(START_SPEED, speed, KP_FAST, KD_FAST, duration / 2, False)\n        line_follower.follow_line_time(speed, START_SPEED, KP_FAST, KD_FAST, duration / 2, stop)\n\ndef follow_line_turn(fast_speed_time, junction, turn):\n    global _square_exit_ready\n    after_square = _square_exit_ready\n    _square_exit_ready = False\n    # A nearby next junction can already be under the front row after Square.\n    # Consume it only once, with the axle-side sensors still before the line.\n    current_exit = (after_square and fast_speed_time == 0\n        and line_follower.read_junction(line_follower.sensor_front) == junction\n        and line_follower.read_calibrated_sensor(8) > 50\n        and line_follower.read_calibrated_sensor(9) > 50)\n    if not current_exit:\n        check_on_line()\n        if fast_speed_time != 0:\n            line_follower.follow_line_time(START_SPEED, FAST_SPEED, KP_FAST, KD_FAST, fast_speed_time / 2, False)\n            line_follower.follow_line_time(FAST_SPEED, START_SPEED, KP_FAST, KD_FAST, fast_speed_time / 2, False)\n        line_follower.follow_line_junction(START_SPEED, SLOW_SPEED, KP_SLOW, KD_SLOW, junction, 1, line_follower.sensor_front)\n    else:\n        robot.motor_stop_all()\n    if turn == spin_left or turn == spin_right:\n        if junction == line_follower.line_left:\n            go_to_center(center_left)\n        elif junction == line_follower.line_right:\n            go_to_center(center_right)\n        else:\n            go_to_center(center_cross)\n    if turn == turn_left:\n        line_follower.turn_check_sensor(robot.left, TURN_SLOW_SPEED, TURN_FAST_SPEED, FAST_TIME_TURN_90, 3)\n    elif turn == turn_right:\n        line_follower.turn_check_sensor(robot.right, TURN_SLOW_SPEED, TURN_FAST_SPEED, FAST_TIME_TURN_90, 4)\n    elif turn == spin_left:\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, 0.05, 0)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, 0, 3)\n    elif turn == spin_right:\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, 0.05, 7)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, 0, 4)\n    else:\n        robot.motor_drive(1, START_SPEED)\n        robot.motor_drive(2, START_SPEED)\n        sleep(0.05)\n        robot.motor_stop_all()\n    sleep(0.02)\n\ndef square_2_junction(line):\n    global _square_exit_ready\n    _square_exit_ready = False\n    fast_speed = 17\n    if line == square_2_junction_l:\n        check_center()\n        go_to_center(center_cross)\n        robot.set_angle_offset(robot.yaw, 0)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 3)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_right, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) < -40:\n            robot.turn_front(robot.right, 40)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_right, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) < 50:\n            robot.turn_front(robot.right, 40)\n        while line_follower.read_calibrated_sensor(0) < 50:\n            robot.motor_drive(1, fast_speed)\n            robot.motor_drive(2, fast_speed)\n        # Detect the exit with the front row before it can steer onto it.\n        while line_follower.read_calibrated_sensor(0) >= 50:\n            line_follower.follow_line(fast_speed, fast_speed, KP_SLOW, KD_SLOW)\n        # Keep the square edge heading until the axle-side sensor reaches it.\n        robot.previous_error = 0\n        while line_follower.read_calibrated_sensor(8) >= 50:\n            robot.forward_degree(90, fast_speed, fast_speed, 1, 1)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0.05, 7)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0, 3)\n        while normalize_angle(robot.read_angle(robot.yaw)) > 5:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n\n    if line == square_2_junction_r:\n        check_center()\n        go_to_center(center_cross)\n        robot.set_angle_offset(robot.yaw, 0)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 4)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) > 40:\n            robot.turn_front(robot.left, 40)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) > -40:\n            robot.turn_front(robot.left, 40)\n        while line_follower.read_calibrated_sensor(7) < 50:\n            robot.motor_drive(1, fast_speed)\n            robot.motor_drive(2, fast_speed)\n        # Detect the exit with the front row before it can steer onto it.\n        while line_follower.read_calibrated_sensor(7) >= 50:\n            line_follower.follow_line(fast_speed, fast_speed, KP_SLOW, KD_SLOW)\n        # Keep the square edge heading until the axle-side sensor reaches it.\n        robot.previous_error = 0\n        while line_follower.read_calibrated_sensor(9) >= 50:\n            robot.forward_degree(-90, fast_speed, fast_speed, 1, 1)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0.05, 0)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0, 4)\n        while normalize_angle(robot.read_angle(robot.yaw)) < -5:\n            robot.spin(robot.right, 10)\n        robot.motor_stop_all()\n    _square_exit_ready = line in (square_2_junction_l, square_2_junction_r)\n\n\ndef square_go_to_center():\n    # Track the side sensors while approaching, before either can pass the bar.\n    from time import ticks_ms, ticks_diff\n    seen = [False, False]\n    front = [False, False]\n    started = ticks_ms()\n    try:\n        values = [line_follower.read_calibrated_sensor(i) for i in (0, 7, 8, 9)]\n        if any(value <= 50 for value in values):\n            # Initial black belongs to the line we are leaving, not the next junction.\n            clear_since = None\n            while True:\n                now = ticks_ms()\n                if ticks_diff(now, started) > 1500:\n                    raise RuntimeError(\"Square entry: could not leave initial line\")\n                if all(value > 50 for value in values):\n                    if clear_since is None:\n                        clear_since = now\n                    elif ticks_diff(now, clear_since) >= 20:\n                        break\n                else:\n                    clear_since = None\n                robot.move(robot.forward, 20)\n                sleep(0.005)\n                values = [line_follower.read_calibrated_sensor(i) for i in (0, 7, 8, 9)]\n        # Start fresh: no initial-line hits can leak into the new junction.\n        started = ticks_ms()\n        while not all(front):\n            if ticks_diff(ticks_ms(), started) > 4000:\n                raise RuntimeError(\"Square entry: front junction not found\")\n            values = [line_follower.read_calibrated_sensor(i) for i in (0, 7, 8, 9)]\n            front[0] = front[0] or values[0] <= 50\n            front[1] = front[1] or values[1] <= 50\n            seen[0] = seen[0] or values[2] <= 50\n            seen[1] = seen[1] or values[3] <= 50\n            # A side sensor reaching the bar is already enough to start alignment.\n            if any(seen) or all(front):\n                break\n            line_follower.follow_line(20, 20, KP_SLOW, KD_SLOW)\n        robot.motor_stop_all()\n        started = ticks_ms()\n        while True:\n            left = line_follower.read_calibrated_sensor(8) <= 50\n            right = line_follower.read_calibrated_sensor(9) <= 50\n            seen[0] = seen[0] or left\n            seen[1] = seen[1] or right\n            if left and right:\n                break\n            if ticks_diff(ticks_ms(), started) > 2000:\n                raise RuntimeError(\"Square entry: side alignment timed out (sensors 8/9)\")\n            # If a sensor has crossed black into white, return to the bar.\n            robot.motor_drive(1, 0 if left else (-12 if seen[0] else 12))\n            robot.motor_drive(2, 0 if right else (-12 if seen[1] else 12))\n            sleep(0.005)\n        robot.move(robot.forward, 20)\n        sleep(time_to_center_left)\n    finally:\n        robot.motor_stop_all()\n\ndef square_4_junction(line):\n    global _square_exit_ready\n    _square_exit_ready = False\n    fast_speed = 15\n    if line == square_4_junction_l:\n        square_go_to_center()\n        robot.set_angle_offset(robot.yaw, 0)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 3)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_right, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) < -40:\n            robot.turn_front(robot.right, 40)\n        while line_follower.read_calibrated_sensor(0) < 50:\n            robot.motor_drive(1, fast_speed)\n            robot.motor_drive(2, fast_speed)\n        # Detect the exit with the front row, then keep the edge heading.\n        while line_follower.read_calibrated_sensor(0) >= 50:\n            line_follower.follow_line(fast_speed, fast_speed, KP_SLOW, KD_SLOW)\n        robot.previous_error = 0\n        while line_follower.read_calibrated_sensor(8) >= 50:\n            robot.forward_degree(0, fast_speed, fast_speed, 1, 1)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0.05, 7)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0, 3)\n        while normalize_angle(robot.read_angle(robot.yaw)) > -80:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n    if line == square_4_junction_r:\n        square_go_to_center()\n        robot.set_angle_offset(robot.yaw, 0)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 4)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) > 40:\n            robot.turn_front(robot.left, 40)\n        while line_follower.read_calibrated_sensor(7) < 50:\n            robot.motor_drive(1, fast_speed)\n            robot.motor_drive(2, fast_speed)\n        # Detect the exit with the front row, then keep the edge heading.\n        while line_follower.read_calibrated_sensor(7) >= 50:\n            line_follower.follow_line(fast_speed, fast_speed, KP_SLOW, KD_SLOW)\n        robot.previous_error = 0\n        while line_follower.read_calibrated_sensor(9) >= 50:\n            robot.forward_degree(0, fast_speed, fast_speed, 1, 1)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0.05, 0)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0, 4)\n        while normalize_angle(robot.read_angle(robot.yaw)) < 80:\n            robot.spin(robot.right, 10)\n        robot.motor_stop_all()\n    elif line == square_4_junction_lf:\n        square_go_to_center()\n        robot.set_angle_offset(robot.yaw, 0)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 3)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_right, 1, line_follower.sensor_front)\n        # Mirror the RF first corner before handing control back to PD.\n        while normalize_angle(robot.read_angle(robot.yaw)) < -10:\n            robot.turn_front(robot.right, 40)\n        # Clear the side outlet before resuming line PD.\n        robot.move(robot.forward, fast_speed)\n        sleep(0.04)\n        while line_follower.read_calibrated_sensor(8) > 50:\n            line_follower.follow_line(fast_speed, fast_speed, KP_SLOW, KD_SLOW)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_right, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) < 50:\n            robot.turn_front(robot.right, 40)\n        while line_follower.read_calibrated_sensor(0) < 50:\n            robot.motor_drive(1, fast_speed)\n            robot.motor_drive(2, fast_speed)\n        # Detect the exit with the front row, then keep the edge heading.\n        while line_follower.read_calibrated_sensor(0) >= 50:\n            line_follower.follow_line(fast_speed, fast_speed, KP_SLOW, KD_SLOW)\n        robot.previous_error = 0\n        while line_follower.read_calibrated_sensor(8) >= 50:\n            robot.forward_degree(90, fast_speed, fast_speed, 1, 1)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0.05, 7)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0, 3)\n        while normalize_angle(robot.read_angle(robot.yaw)) > 5:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n    elif line == square_4_junction_rf:\n        square_go_to_center()\n        robot.set_angle_offset(robot.yaw, 0)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 4)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        # Finish the corner before PD can capture the side outlet.\n        # At 40 degrees the front row can straddle both crossing lines.\n        while normalize_angle(robot.read_angle(robot.yaw)) > 10:\n            robot.turn_front(robot.left, 40)\n        # Clear the side outlet before resuming line PD.\n        robot.move(robot.forward, fast_speed)\n        sleep(0.04)\n        while line_follower.read_calibrated_sensor(9) > 50:\n            line_follower.follow_line(fast_speed, fast_speed, KP_SLOW, KD_SLOW)\n        line_follower.follow_line_junction(fast_speed, fast_speed, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) > -40:\n            robot.turn_front(robot.left, 40)\n        while line_follower.read_calibrated_sensor(7) < 50:\n            robot.motor_drive(1, fast_speed)\n            robot.motor_drive(2, fast_speed)\n        # Detect the exit with the front row, then keep the edge heading.\n        while line_follower.read_calibrated_sensor(7) >= 50:\n            line_follower.follow_line(fast_speed, fast_speed, KP_SLOW, KD_SLOW)\n        robot.previous_error = 0\n        while line_follower.read_calibrated_sensor(9) >= 50:\n            robot.forward_degree(-90, fast_speed, fast_speed, 1, 1)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0.05, 0)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0, 4)\n        while normalize_angle(robot.read_angle(robot.yaw)) < -5:\n            robot.spin(robot.right, 10)\n        robot.motor_stop_all()\n    _square_exit_ready = line in (square_4_junction_l, square_4_junction_r, square_4_junction_lf, square_4_junction_rf)\n\n\ndef square_2_junction_pick(line):\n    global _square_exit_ready\n    _square_exit_ready = False\n    global SERVO_UP, SERVO_DOWN, SERVO_OPEN, SERVO_CLOSE\n    if line == square_2_junction_l:\n        check_center()\n        go_to_center(center_cross)\n        robot.set_angle_offset(robot.yaw, 0)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, FAST_TIME_SPIN_90, 3)\n        line_follower.follow_line_junction(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, line_follower.line_right, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) < -40:\n            robot.turn_front(robot.right, 40)\n        line_follower.follow_line_junction(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, line_follower.line_right, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) < 30:\n            robot.spin(robot.right, 10)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_DOWN)\n        robot.servo_set_degree(1, SERVO_OPEN)\n        robot.forward_degree_time(30, 10, 10, 1, 1, 0.3)\n        robot.move(robot.forward, 5)\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        sleep(0.3)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_UP)\n        while normalize_angle(robot.read_angle(robot.yaw)) < 85:\n            robot.spin(robot.right, 10)\n        robot.motor_stop_all()\n        robot.move(robot.forward, 20)\n        sleep(0.15)\n        robot.motor_stop_all()\n        robot.set_angle_offset(robot.yaw, 0)\n        robot.spin_degree(90, 3, 10, 20, 0.5, 0)\n        robot.backward_degree_time(90, 10, 20, 1, 1, 0.6)\n    if line == square_2_junction_r:\n        check_center()\n        go_to_center(center_cross)\n        robot.set_angle_offset(robot.yaw, 0)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, FAST_TIME_SPIN_90, 4)\n        line_follower.follow_line_junction(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) > 40:\n            robot.turn_front(robot.left, 40)\n        line_follower.follow_line_junction(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        while normalize_angle(robot.read_angle(robot.yaw)) > -30:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_DOWN)\n        robot.servo_set_degree(1, SERVO_OPEN)\n        robot.forward_degree_time(-30, 10, 10, 1, 1, 0.3)\n        robot.move(robot.forward, 5)\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        sleep(0.3)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_UP)\n        while normalize_angle(robot.read_angle(robot.yaw)) > -85:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n        robot.move(robot.forward, 20)\n        sleep(0.15)\n        robot.motor_stop_all()\n        robot.set_angle_offset(robot.yaw, 0)\n        robot.spin_degree(-90, 3