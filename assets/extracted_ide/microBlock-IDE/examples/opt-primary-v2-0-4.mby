rvo_set_degree(1, SERVO_CLOSE)\n        sleep(0.3)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_UP)\n        while normalize_angle(robot.read_angle(robot.yaw)) < -45:\n            robot.spin(robot.right, 10)\n        robot.motor_stop_all()\n        go_to_center(center_right)\n        robot.spin_degree(90, 3, 10, 20, 0.5, 0)\n        robot.backward_degree_time(90, 10, 20, 1, 1, 0.6)\n    elif line == diamond_4_junction_r:\n        check_center_diamond()\n        while True:\n            sensor_left_value = line_follower.read_calibrated_sensor(8)\n            sensor_right_value = line_follower.read_calibrated_sensor(9)\n            if sensor_left_value > 50:\n                robot.motor_drive(1, slow_speed)\n            else:\n                robot.motor_drive(1, 0)\n            if sensor_right_value > 50:\n                robot.motor_drive(2, slow_speed)\n            else:\n                robot.motor_drive(2, 0)\n            if sensor_left_value < 50 and sensor_right_value < 50:\n                break\n        robot.set_angle_offset(robot.yaw, 0)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, 0.03, 4)\n        robot.servo_set_degree(0, SERVO_UP)\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        line_follower.follow_line_junction(10, 10, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        robot.servo_set_degree(1, SERVO_OPEN)\n        while normalize_angle(robot.read_angle(robot.yaw)) < 65:\n            robot.spin(robot.right, 10)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_DOWN)\n        sleep(0.1)\n        robot.forward_degree_time(65, 10, 10, 1, 1, 0.2)\n        robot.move(robot.forward, 5)\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        sleep(0.3)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_UP)\n        while normalize_angle(robot.read_angle(robot.yaw)) > 45:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n        go_to_center(center_left)\n        robot.spin_degree(-90, 3, 10, 20, 0.5, 0)\n        robot.backward_degree_time(-90, 10, 20, 1, 1, 0.6)\n    elif line == diamond_4_junction_lf:\n        check_center_diamond()\n        while True:\n            sensor_left_value = line_follower.read_calibrated_sensor(8)\n            sensor_right_value = line_follower.read_calibrated_sensor(9)\n            if sensor_left_value > 50:\n                robot.motor_drive(1, slow_speed)\n            else:\n                robot.motor_drive(1, 0)\n            if sensor_right_value > 50:\n                robot.motor_drive(2, slow_speed)\n            else:\n                robot.motor_drive(2, 0)\n            if sensor_left_value < 50 and sensor_right_value < 50:\n                break\n        robot.set_angle_offset(robot.yaw, -90)\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, 0.03, 3)\n        line_follower.follow_line_junction(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, line_follower.line_right, 1, line_follower.sensor_front)\n        line_follower.turn_check_sensor(robot.right, TURN_SLOW_SPEED, TURN_FAST_SPEED, 0.2, 4)\n        robot.servo_set_degree(0, SERVO_UP)\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        line_follower.follow_line_junction(10, 10, KP_SLOW, KD_SLOW, line_follower.line_right, 1, line_follower.sensor_front)\n        robot.servo_set_degree(1, SERVO_OPEN)\n        while normalize_angle(robot.read_angle(robot.yaw)) > -65:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_DOWN)\n        sleep(0.1)\n        robot.forward_degree_time(-65, 10, 10, 1, 1, 0.2)\n        robot.move(robot.forward, 5)\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        sleep(0.3)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_UP)\n        while normalize_angle(robot.read_angle(robot.yaw)) < -45:\n            robot.spin(robot.right, 10)\n        robot.motor_stop_all()\n        go_to_center(center_right)\n        robot.spin_degree(90, 3, 10, 20, 0.5, 0)\n        robot.backward_degree_time(90, 10, 20, 1, 1, 0.6)\n    elif line == diamond_4_junction_rf:\n        check_center_diamond()\n        while True:\n            sensor_left_value = line_follower.read_calibrated_sensor(8)\n            sensor_right_value = line_follower.read_calibrated_sensor(9)\n            if sensor_left_value > 50:\n                robot.motor_drive(1, slow_speed)\n            else:\n                robot.motor_drive(1, 0)\n            if sensor_right_value > 50:\n                robot.motor_drive(2, slow_speed)\n            else:\n                robot.motor_drive(2, 0)\n            if sensor_left_value < 50 and sensor_right_value < 50:\n                break\n        robot.set_angle_offset(robot.yaw, 90)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, 0.03, 4)\n        line_follower.follow_line_junction(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        line_follower.turn_check_sensor(robot.left, TURN_SLOW_SPEED, TURN_FAST_SPEED, 0.2, 3)\n        robot.servo_set_degree(0, SERVO_UP)\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        line_follower.follow_line_junction(10, 10, KP_SLOW, KD_SLOW, line_follower.line_left, 1, line_follower.sensor_front)\n        robot.servo_set_degree(1, SERVO_OPEN)\n        while normalize_angle(robot.read_angle(robot.yaw)) < 65:\n            robot.spin(robot.right, 10)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_DOWN)\n        sleep(0.1)\n        robot.forward_degree_time(65, 10, 10, 1, 1, 0.2)\n        robot.move(robot.forward, 5)\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        sleep(0.3)\n        robot.motor_stop_all()\n        robot.servo_set_degree(0, SERVO_UP)\n        while normalize_angle(robot.read_angle(robot.yaw)) > 45:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n        go_to_center(center_left)\n        robot.spin_degree(-90, 3, 10, 20, 0.5, 0)\n        robot.backward_degree_time(-90, 10, 20, 1, 1, 0.6)\n\ndef zigzag():\n    global _square_exit_ready\n    _square_exit_ready = False\n    align_robot()\n    line_follower.follow_line_sensor(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, 7, 1)\n    line_follower.turn_check_sensor(robot.right, SLOW_SPEED, FAST_SPEED, 0.10, 4)\n    line_follower.follow_line_sensor(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, 0, 1)\n    line_follower.turn_check_sensor(robot.left, SLOW_SPEED, FAST_SPEED, 0.10, 3)\n\ndef zigzag_pick():\n    global _square_exit_ready\n    _square_exit_ready = False\n    align_robot()\n    line_follower.follow_line_sensor(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, 7, 1)\n    line_follower.turn_check_sensor(robot.right, SLOW_SPEED, FAST_SPEED, 0.10, 4)\n    line_follower.follow_line_sensor(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, 0, 1)\n    robot.servo_set_degree(1, SERVO_CLOSE)\n    while line_follower.read_calibrated_sensor(8) > 50:\n        robot.motor_drive(1, 15)\n        robot.motor_drive(2, 15)\n    line_follower.spin_check_sensor(robot.left, SLOW_SPEED, FAST_SPEED, FAST_TIME_SPIN_90, 3)\n    sleep(0.1)\n    robot.servo_set_degree(1, SERVO_OPEN)\n    sleep(0.1)\n    robot.servo_set_degree(0, SERVO_DOWN)\n    sleep(0.1)\n    robot.move(robot.forward, 8)\n    sleep(0.15)\n    line_follower.follow_line_time(10, 10, 0.015, 0.0, 0.35, False)\n    robot.move(robot.forward, 5)\n    sleep(0.2)\n    robot.motor_stop_all()\n    pick_can_slow()\n    sleep(0.3)\n    robot.servo_set_degree(0, SERVO_UP)\n    sleep(0.15)\n    robot.move(robot.forward, 10)\n    sleep(0.5)\n    robot.motor_stop_all()\n    robot.spin(robot.left, SPIN_SLOW_SPEED)\n    sleep(0.3)\n    robot.motor_stop_all()\n    line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 3)\n    zigzag()\n\ndef curve():\n    global _square_exit_ready\n    _square_exit_ready = False\n    turn_slow_speed = 20\n    # check_on_line()\n    line_follower.follow_line_sensor(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, 7, 1)\n    robot.set_angle_offset(robot.yaw, 0)\n    while line_follower.read_calibrated_sensor(3) < 50:\n        robot.turn_front(robot.right, turn_slow_speed)\n    line_follower.turn_check_sensor(robot.right, turn_slow_speed, turn_slow_speed, 0.1, 3)\n    line_follower.follow_line_time(START_SPEED, START_SPEED, 0.10, 0.10, 0.9, True)\n    line_follower.follow_line_sensor(START_SPEED, START_SPEED, 0.10, 0.10, 0, 1)\n    while normalize_angle(robot.read_angle(robot.yaw)) < 85:\n        robot.spin(robot.right, 10)\n    while line_follower.read_calibrated_sensor(8) > 50:\n        robot.move(robot.forward, 15)\n    while line_follower.read_calibrated_sensor(8) < 50:\n        robot.move(robot.forward, 10)\n    line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 2)\n    line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0, 3)\n    while normalize_angle(robot.read_angle(robot.yaw)) > 2:\n        robot.spin(robot.left, 10)\n    robot.motor_stop_all()\n\ndef curve_pick():\n    global _square_exit_ready\n    _square_exit_ready = False\n    # check_on_line()\n    line_follower.follow_line_sensor(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, 7, 1)\n    robot.servo_set_degree(0, SERVO_UP)\n    robot.servo_set_degree(1, SERVO_CLOSE)\n    line_follower.turn_check_sensor(robot.right, TURN_SLOW_SPEED, TURN_FAST_SPEED, 0.1, 3)\n    line_follower.follow_line_time(START_SPEED, START_SPEED, 0.15, 0.15, 0.5, True)\n    line_follower.follow_line_sensor(START_SPEED, START_SPEED, 0.1, 0.1, 7, 1)\n    robot.set_angle_offset(robot.yaw, 0)\n    robot.turn_degree_front(70, 3, 15, 15, 0.5, 0)\n    robot.servo_set_degree(1, SERVO_OPEN)\n    robot.spin_degree(102, 3, 15, 15, 0.5, 0)\n    robot.servo_set_degree(0, SERVO_DOWN)\n    robot.servo_set_degree(1, SERVO_OPEN)\n    sleep(0.1)\n    robot.forward_degree_time(102, 10, 10, 1, 1, 0.27)\n    robot.move(robot.forward, 5)\n    robot.servo_set_degree(1, SERVO_CLOSE)\n    sleep(0.3)\n    robot.motor_stop_all()\n    robot.servo_set_degree(0, SERVO_UP)\n    sleep(0.15)\n    robot.spin(robot.left, SPIN_SLOW_SPEED)\n    sleep(0.3)\n    robot.motor_stop_all()\n    line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 5)\n    line_follower.follow_line_time(START_SPEED, START_SPEED, 0.10, 0.10, 0.65, True)\n    line_follower.follow_line_sensor(START_SPEED, START_SPEED, 0.10, 0.10, 0, 1)\n    while normalize_angle(robot.read_angle(robot.yaw)) < -20:\n        robot.spin(robot.right, 10)\n    robot.motor_stop_all()\n    while line_follower.read_calibrated_sensor(8) > 50:\n        robot.move(robot.forward, 15)\n    while line_follower.read_calibrated_sensor(8) < 50:\n        robot.move(robot.forward, 10)\n    line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 2)\n    line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, 0, 3)\n    while normalize_angle(robot.read_angle(robot.yaw)) > -100:\n        robot.spin(robot.left, 10)\n    robot.motor_stop_all()\n\ndef obstacle(duration):\n    global _square_exit_ready\n    _square_exit_ready = False\n    check_on_line()\n    sensor_offset = 0\n    for i in range(10):\n        sensor_offset = line_follower.read_calibrated_sensor(0)\n    while True:\n        sensor_value = line_follower.read_calibrated_sensor(0)\n        if sensor_value < sensor_offset - 20 or sensor_value > sensor_offset + 20:\n            break\n        line_follower.follow_line(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW)\n    # Keep the startup direction even when other Custom blocks reset yaw.\n    current = (robot.read_angle(robot.yaw) + robot.angles_offset[2] - _OBSTACLE_START_YAW) % 360\n    nearest = (int((current + 45) // 90) * 90) % 360\n    target = (_OBSTACLE_START_YAW + nearest - robot.angles_offset[2]) % 360\n    robot.forward_degree_time(target, 5, 5, 1, 1, 0.1)\n    robot.forward_degree_time(target, 20, 20, 1, 1, duration)\n    robot.motor_stop_all()\n\ndef zigzag_curve(line):    \n    global _square_exit_ready\n    _square_exit_ready = False\n    while line_follower.read_calibrated_sensor(0) < 50 or line_follower.read_calibrated_sensor(7) < 50:\n        robot.move(robot.forward, SLOW_SPEED)\n    robot.motor_stop_all()\n    \n    if line == zigzag_to_curve:\n        line_follower.follow_line_time(START_SPEED, START_SPEED, 0.12, 0.12, 0.2, True)\n        line_follower.follow_line_sensor(START_SPEED, SLOW_SPEED, 0.12, 0.12, 0, 1)\n        line_follower.turn_check_sensor(robot.left, TURN_SLOW_SPEED, TURN_FAST_SPEED, FAST_TIME_TURN_90, 3)\n        line_follower.follow_line_time(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, 0.2, True)\n        line_follower.turn_check_sensor(robot.right, TURN_SLOW_SPEED, TURN_SLOW_SPEED, 0.02, 3)\n    elif line == curve_to_zigzag:\n        line_follower.follow_line_time(START_SPEED, START_SPEED, 0.12, 0.12, 0.45, True)\n        line_follower.follow_line_sensor(START_SPEED, START_SPEED, 0.12, 0.12, 7, 1)\n        go_to_center(center_right)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, FAST_TIME_SPIN_90, 2)\n\ndef zigzag_curve_pick(line):\n    global _square_exit_ready\n    _square_exit_ready = False\n    while line_follower.read_calibrated_sensor(0) < 50 or line_follower.read_calibrated_sensor(7) < 50:\n        robot.move(robot.forward, SLOW_SPEED)\n    robot.motor_stop_all()\n    \n    if line == zigzag_to_curve:\n        line_follower.follow_line_time(START_SPEED, START_SPEED, 0.12, 0.12, 0.2, True)\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        line_follower.follow_line_sensor(START_SPEED, SLOW_SPEED, 0.12, 0.12, 0, 1)\n        line_follower.turn_check_sensor(robot.left, TURN_SLOW_SPEED, TURN_FAST_SPEED, FAST_TIME_TURN_90, 3)\n        line_follower.follow_line_time(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, 0.25, True)\n        robot.servo_set_degree(1, SERVO_OPEN)\n        sleep(0.1)\n        robot.servo_set_degree(0, SERVO_DOWN)\n        sleep(0.2)\n        line_follower.follow_line_time(10, 10, 0.015, 0.0, 0.75, False)\n        robot.move(robot.forward, 5)\n        sleep(0.2)\n        robot.motor_stop_all()\n        pick_can_slow()\n        sleep(0.3)\n        robot.servo_set_degree(0, SERVO_UP)\n        sleep(0.15)\n        robot.spin(robot.left, SPIN_SLOW_SPEED)\n        sleep(0.3)\n        robot.motor_stop_all()\n        line_follower.spin_check_sensor(robot.left, SPIN_SLOW_SPEED, SPIN_SLOW_SPEED, FAST_TIME_SPIN_90, 5)\n        line_follower.follow_line_time(START_SPEED, START_SPEED, 0.12, 0.12, 0.10, True)\n        line_follower.follow_line_sensor(START_SPEED, START_SPEED, 0.12, 0.12, 7, 1)\n        go_to_center(center_right)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, 0.05, 3)\n    elif line == curve_to_zigzag:\n        robot.servo_set_degree(1, SERVO_CLOSE)\n        line_follower.follow_line_time(START_SPEED, START_SPEED, 0.12, 0.12, 0.45, True)\n        line_follower.follow_line_sensor(START_SPEED, START_SPEED, 0.12, 0.12, 7, 1)\n        go_to_center(center_right)\n        line_follower.spin_check_sensor(robot.right, SPIN_SLOW_SPEED, SPIN_FAST_SPEED, 0.05, 3)\n        sleep(0.1)\n        robot.set_angle_offset(robot.yaw, 0)\n        robot.servo_set_degree(1, SERVO_OPEN)\n        sleep(0.1)\n        robot.servo_set_degree(0, SERVO_DOWN)\n        sleep(0.1)\n        line_follower.follow_line_time(10, 10, 0.015, 0.0, 0.2, False)\n        while normalize_angle(robot.read_angle(robot.yaw)) > -10:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n        robot.move(robot.forward, 5)\n        sleep(0.2)\n        robot.motor_stop_all()\n        robot.set_angle_offset(robot.yaw, -10)\n        pick_can_slow()\n        sleep(0.3)\n        robot.servo_set_degree(0, SERVO_UP)\n        sleep(0.15)\n        robot.spin(robot.left, SPIN_SLOW_SPEED)\n        sleep(0.4)\n        while normalize_angle(robot.read_angle(robot.yaw)) > -170:\n            robot.spin(robot.left, 10)\n        robot.motor_stop_all()\n        sleep(0.15)\n        robot.move(robot.backward, 15)\n        sleep(0.5)\n        robot.motor_stop_all()\n        sleep(0.1)\n        line_follower.follow_line_sensor(START_SPEED, SLOW_SPEED, 0.12, 0.12, 0, 1)\n        line_follower.turn_check_sensor(robot.left, TURN_SLOW_SPEED, TURN_FAST_SPEED, FAST_TIME_TURN_90, 3)\n        line_follower.follow_line_time(START_SPEED, START_SPEED, KP_SLOW, KD_SLOW, 0.2, True)\n        line_follower.turn_check_sensor(robot.right, TURN_SLOW_SPEED, TURN_SLOW_SPEED, 0.02, 3)"
        },
