e=\"NUM\">20</field></shadow></value><value name=\"max_speed\"><shadow type=\"math_number\"><field name=\"NUM\">70</field></shadow></value><value name=\"KP\"><shadow type=\"math_number\"><field name=\"NUM\">0.6</field></shadow></value><value name=\"KD\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value><value name=\"time\"><shadow type=\"math_number\"><field name=\"NUM\">0.3</field></shadow></value><next><block type=\"motor_stop\"><next><block type=\"math_change\"><field name=\"VAR\">heading</field><value name=\"DELTA\"><shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow></value><next><block type=\"motor_spin_degree\"><value name=\"angle\"><block type=\"variables_get\"><field name=\"VAR\">heading</field></block></value><value name=\"slow_angle\"><shadow type=\"math_number\"><field name=\"NUM\">70</field></shadow></value><value name=\"stop_threshold\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value><value name=\"min_speed\"><shadow type=\"math_number\"><field name=\"NUM\">50</field></shadow></value><value name=\"max_speed\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value><value name=\"KP\"><shadow type=\"math_number\"><field name=\"NUM\">1.5</field></shadow></value><value name=\"KD\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value><next><block type=\"motor_stop\"><next><block type=\"controls_wait\"><value name=\"time\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></statement><next><block type=\"print\"><value name=\"value\"><shadow type=\"text\"><field name=\"TEXT\">Square demo finished</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><next><bloc